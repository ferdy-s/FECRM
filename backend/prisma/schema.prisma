generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum UserRole {
  MARKETING
  SALES
  ADMIN
  FINANCE
  MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATION
  WON
  LOST
}

enum NegotiationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NegotiationScope {
  ITEM
  TOTAL
}

enum DealStatus {
  OPEN
  NEGOTIATION
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  QRIS_MIDTRANS
}

enum PaymentType {
  FULL
  TERMIN
}

enum InvoiceKind {
  MASTER
  TERMIN
}

enum CollectionStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ActivityType {
  SYSTEM
  NOTE
  STATUS
  ASSIGNMENT
  COMMUNICATION
  NEGOTIATION
  FINANCE
  CALL
  MEETING
  EMAIL
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum CommunicationChannel {
  WA
  EMAIL
  CALL
}

enum CommunicationStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

//////////////////////////////////////////////////
// AUTH
//////////////////////////////////////////////////

model Auth {
  id           String    @id @default(uuid())
  userId       String    @unique
  passwordHash String
  refreshToken String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

//////////////////////////////////////////////////
// CORE MODELS
//////////////////////////////////////////////////

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  role      UserRole
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  auth Auth?

  leadsAssigned Lead[] @relation("LeadAssigned")
  leadsCreated  Lead[] @relation("LeadCreated")

  negotiationRequests NegotiationRequest[]  @relation("NegotiationRequester")

negotiationApprovals NegotiationRequest[] @relation("NegotiationApprover")

  dealsAssigned Deal[] @relation("DealAssigned")
  dealsCreated  Deal[] @relation("DealCreated")

  uploadedPayments Payment[] @relation("PaymentUploader")

  verifiedPayments Payment[] @relation("PaymentVerifier")

  activities     Activity[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  negotiations   NegotiationNote[]
  communications CommunicationLog[]

  @@map("users")
}

model Lead {
  id             String     @id @default(uuid())
  name           String
  company        String?
  email          String?
  phone          String?

  address String?

  district String?

  city String?

  province String?

  postalCode String?

  country String? @default("Indonesia")
  sourceId       String
  assignedTo     String
  createdBy      String
  status         LeadStatus @default(NEW)
  lastActivityAt DateTime?
  createdAt      DateTime   @default(now())
  deletedAt      DateTime?

  source   LeadSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  assignee User       @relation("LeadAssigned", fields: [assignedTo], references: [id], onDelete: Restrict)
  creator  User       @relation("LeadCreated", fields: [createdBy], references: [id], onDelete: Restrict)

  activities     Activity[]
  deals          Deal[]
  communications CommunicationLog[]

  @@index([assignedTo])
  @@index([status])
  @@index([sourceId])
  @@index([lastActivityAt])
  @@map("leads")
}

model Activity {
  id          String       @id @default(uuid())
  leadId      String
  userId      String
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([createdAt])
  @@map("activities")
}

model NegotiationNote {

  id String @id @default(uuid())

  dealId String

  userId String

  note String

  createdAt DateTime @default(now())

  deal Deal @relation(fields:[dealId],references:[id],onDelete: Restrict)

  user User @relation(          fields:[userId],          references:[id],          onDelete: Restrict )

  @@index([dealId])

  @@map("negotiation_notes")

}

model Deal {

id         String @id @default(uuid())
leadId     String @unique
assignedTo String
createdBy  String
subtotal Decimal    @default(0) @db.Decimal(18,2)
discountAmount Decimal @default(0) @db.Decimal(18,2)
grandTotal Decimal @default(0)  @db.Decimal(18,2)

negotiatedAt DateTime?

value Decimal @default(0) @db.Decimal(18,2)
status DealStatus @default(OPEN)
collectionStatus CollectionStatus @default(UNPAID)
collectedAmount Decimal @default(0) @db.Decimal(18,2)
outstandingAmount Decimal @default(0) @db.Decimal(18,2)
createdAt DateTime @default(now())
deletedAt DateTime?
lead Lead @relation(fields: [leadId],references: [id],      onDelete: Restrict)
assignee User @relation("DealAssigned",      fields: [assignedTo],references: [id],      onDelete: Restrict)
creator User @relation("DealCreated",      fields: [createdBy],references: [id],onDelete: Restrict )
items TransactionItem[]
negotiations NegotiationRequest[]
notes NegotiationNote[]
invoices Invoice[]

@@index([leadId])
@@index([assignedTo])
@@index([status])
@@index([collectionStatus])
@@index([createdAt])
@@map("deals")
}

model NegotiationRequest {

id String @id @default(uuid())
dealId String
transactionItemId String?

scope NegotiationScope

requestedBy String
approvedBy String?

status NegotiationStatus @default(PENDING)

oldAmount Decimal @db.Decimal(18,2)
requestedAmount Decimal @db.Decimal(18,2)
approvedAmount Decimal? @db.Decimal(18,2)

reason String?
remarks String?
reviewedAt DateTime?
createdAt DateTime @default(now())

deal Deal @relation(          fields: [dealId],          references: [id],          onDelete: Restrict )
item TransactionItem?      @relation(          fields: [transactionItemId],          references: [id],          onDelete: Restrict )
requester User @relation(          "NegotiationRequester", fields: [requestedBy],          references: [id]      )
approver User? @relation("NegotiationApprover",          fields: [approvedBy],          references: [id]  )

@@index([dealId])
@@index([transactionItemId])
@@index([scope])
@@index([status])
@@index([dealId, status])
@@map("negotiation_requests")

}

model Invoice {
  id String @id @default(uuid())

  dealId String

  parentInvoiceId String?

  invoiceNumber String?

  invoiceKind InvoiceKind

  paymentType PaymentType

  paymentMethod PaymentMethod

  amount Decimal @db.Decimal(18,2)

  paidAmount Decimal    @default(0)    @db.Decimal(18,2)

  remainingAmount Decimal    @default(0)    @db.Decimal(18,2)

  percent Decimal?    @db.Decimal(5,2)

  dueDate DateTime?

  status InvoiceStatus    @default(UNPAID)

  midtransOrderId String?

  qrisUrl String?

  issuedAt DateTime   @default(now())

  deletedAt DateTime?

  deal Deal    @relation(      fields: [dealId],      references: [id],      onDelete: Restrict    )

  parentInvoice Invoice?    @relation(      "InvoiceHierarchy",      fields: [parentInvoiceId],      references: [id]    )

  childInvoices Invoice[]    @relation("InvoiceHierarchy")

  payments Payment[]

  items InvoiceItem[]


@@index([dealId])
@@index([status])
@@index([invoiceKind])
@@index([parentInvoiceId])
@@index([dueDate])
@@index([issuedAt])
@@map("invoices")
}

model InvoiceItem {

  id String @id @default(uuid())

  invoiceId String

  itemType ItemType

  itemName String

  quantity Int

  unitPrice Decimal @db.Decimal(18,2)

  totalPrice Decimal @db.Decimal(18,2)

  createdAt DateTime @default(now())

  invoice Invoice    @relation(      fields: [invoiceId],      references: [id],      onDelete: Restrict    )

  @@index([invoiceId])

  @@map("invoice_items")
}

model Payment {
  id String @id @default(uuid())

  invoiceId String

  amount Decimal @db.Decimal(18,2)

  paymentMethod PaymentMethod

  proofUrl String?

  referenceNumber String?

  status PaymentStatus @default(PENDING)

  uploadedBy String?

  verifiedBy String?

  verifiedAt DateTime?

  paidAt DateTime?

  midtransTransactionId String?

  gatewayResponse Json?

  createdAt DateTime @default(now())

  invoice Invoice    @relation(      fields: [invoiceId],      references: [id],      onDelete: Restrict    )

  uploader User?    @relation(      "PaymentUploader",      fields: [uploadedBy],      references: [id]    )

  verifier User?    @relation(      "PaymentVerifier",      fields: [verifiedBy],      references: [id]    )

  @@index([invoiceId])

  @@index([status])

  @@index([paymentMethod])

  @@index([paidAt])

  @@index([createdAt])

  @@map("payments")
}

//////////////////////////////////////////////////
// PRODUCT & SERVICE
//////////////////////////////////////////////////

model Product {
  id    String  @id @default(uuid())
  name  String
  price Decimal @db.Decimal(18, 2)

  @@map("products")
}

model Service {
  id    String  @id @default(uuid())
  name  String
  price Decimal @db.Decimal(18, 2)

  @@map("services")
}

model TransactionItem {

  id String @id @default(uuid())

  dealId String

  type ItemType

  refId String

  itemName String?

  quantity Int

  price Decimal @db.Decimal(18,2)

  unitPrice Decimal @db.Decimal(18,2)

  totalPrice Decimal @db.Decimal(18,2)

  createdAt DateTime @default(now())

  deal Deal    @relation(      fields: [dealId],      references: [id],      onDelete: Restrict   )

  negotiations NegotiationRequest[]

  @@index([dealId])

  @@map("transaction_items")
}

model CommunicationLog {
  id         String                 @id @default(uuid())
  leadId     String
  userId     String
  channel    CommunicationChannel
  direction  CommunicationDirection
  message    String
  status     CommunicationStatus    @default(SENT)
  externalId String?
  createdAt  DateTime               @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([createdAt])
  @@map("communication_logs")
}

//////////////////////////////////////////////////
// SUPPORTING
//////////////////////////////////////////////////

model LeadSource {
  id   String @id @default(uuid())
  name String

  leads Lead[]

  @@map("lead_sources")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  oldData   Json?
  newData   Json?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}